# graphify knowledge-graph output, regenerated on run
/graphify-out/

# Timestamped risk-report snapshots, regenerated on run (latest_risk_report.pdf stays tracked)
reports/risk_report_*.pdf

# Generated quarterly research notes (Q-Report analyzer)
reports/qreport_*.pdf

# Compiled Go binaries (command_center/, mcp_gateway/)
/command_center/command_center
/mcp_gateway/mcp_gateway

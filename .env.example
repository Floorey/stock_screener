# Server-side only. Copy to .env, chmod 600 .env; never paste keys into chat/UI.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Bind to the exact paper account ID after verifying /account.
ALPACA_ACCOUNT_ID=
ALPACA_TRADING_ENABLED=false
ALPACA_STOCK_FEED=sip
ALPACA_OPTION_FEED=indicative
FRED_API_KEY=
# deploy/prepare.py creates ANALYTICS_DATABASE_URL in .runtime/runtime.env.

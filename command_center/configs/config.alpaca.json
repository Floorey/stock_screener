{
  "addr": "127.0.0.1:8080",
  "provider": "alpaca",
  "log_level": "info",
  "shutdown_timeout": "10s",
  "series": {
    "balance": {
      "enabled": true,
      "mode": "poll",
      "interval": "15s",
      "timeout": "5s",
      "capacity": 720
    },
    "orderbook": {
      "enabled": true,
      "mode": "stream",
      "capacity": 5000,
      "symbols": ["SPY"]
    }
  },
  "alpaca": {
    "base_url": "https://paper-api.alpaca.markets",
    "data_url": "https://data.alpaca.markets",
    "stream_url": "wss://stream.data.alpaca.markets",
    "feed": "iex"
  }
}

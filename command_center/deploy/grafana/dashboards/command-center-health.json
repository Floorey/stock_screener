{
  "uid": "cc-health",
  "title": "Command Center — Pipeline Health",
  "description": "Is the data on the trading dashboard still worth looking at? Freshness, error behaviour and buffer state of every series, plus the service itself.",
  "tags": ["command-center", "health"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "series",
        "label": "Series",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
        "query": "label_values(cc_series_info, series)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend",
      "description": "1 while Prometheus can scrape the service.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "up{job=\"command_center\"}",
          "legendFormat": "up"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime",
      "description": "Ring buffers are in-memory only — a restart drops all history.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_uptime_seconds",
          "legendFormat": "uptime"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Stale series",
      "description": "Polled series that missed two update cycles. Streamed series never count here — watch their staleness panel instead.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "sum(cc_series_stale)",
          "legendFormat": "stale"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Worst error streak",
      "description": "Consecutive failed fetches on the unhealthiest series. Drives exponential backoff, so recovery lags the upstream fix.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "max(cc_series_consecutive_errors)",
          "legendFormat": "streak"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Handler panics",
      "description": "Caught by the recovery middleware, so the process survived — but any value above zero is a bug.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_http_handler_panics_total",
          "legendFormat": "panics"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Sample age per series",
      "description": "How old the newest buffered sample is. A source that never came up counts from process start, so it still shows a growing age instead of nothing.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_series_staleness_seconds{series=~\"$series\"}",
          "legendFormat": "{{series}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Update rate",
      "description": "Samples per second reaching the buffer. Compare against cc_series_interval_seconds for polled sources.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["mean"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "rate(cc_series_updates_total{series=~\"$series\"}[1m])",
          "legendFormat": "{{series}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Fetch error rate",
      "description": "Failed fetches per second. The buffer keeps its last valid value throughout — errors degrade freshness, they never blank the dashboard.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "rate(cc_series_errors_total{series=~\"$series\"}[5m])",
          "legendFormat": "{{series}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Consecutive errors",
      "description": "Resets to zero on the first successful update. A sawtooth means the source is flapping.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_series_consecutive_errors{series=~\"$series\"}",
          "legendFormat": "{{series}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Buffer fill",
      "description": "Buffered samples as a fraction of ring capacity. Once at 100% the oldest sample is dropped on every write — that is the retained window.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_series_buffered_samples{series=~\"$series\"} / cc_series_capacity{series=~\"$series\"}",
          "legendFormat": "{{series}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Live subscribers",
      "description": "Consumers attached to the series fan-out — websocket dashboard clients once step 4 lands.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_series_subscribers{series=~\"$series\"}",
          "legendFormat": "{{series}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "HTTP requests",
      "description": "By route pattern and status. Raw paths are never used as labels, so this cannot explode in cardinality.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "sum by (route, status) (rate(cc_http_requests_total[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Request latency (p95)",
      "description": "Everything is served from memory, so anything above a few milliseconds means the process is under pressure.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(cc_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Runtime",
      "description": "Goroutines and heap. A goroutine count that only grows is a leaked poller or an un-closed subscription.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 37 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "heap" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_go_goroutines",
          "legendFormat": "goroutines"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_go_memstats_heap_alloc_bytes",
          "legendFormat": "heap"
        }
      ]
    }
  ]
}

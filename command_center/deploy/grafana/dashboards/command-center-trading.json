{
  "uid": "cc-trading",
  "title": "Command Center — Trading",
  "description": "Account and market values from the command center buffer. Every panel here is only as trustworthy as the freshness shown on the Pipeline Health dashboard.",
  "tags": ["command-center", "trading"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "symbol",
        "label": "Symbol",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
        "query": "label_values(cc_orderbook_levels, symbol)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Equity",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_account_equity",
          "legendFormat": "{{account}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Day PnL",
      "description": "equity − last_equity, derived by the backend. Alpaca has no day-PnL field.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_account_pnl_day",
          "legendFormat": "{{account}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Mid price",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_orderbook_mid_price{symbol=~\"$symbol\"}",
          "legendFormat": "{{symbol}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Spread",
      "description": "Top-of-book spread in basis points of the mid price. Wide spread means execution assumptions built on a tight one do not hold.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_orderbook_spread_bps{symbol=~\"$symbol\"}",
          "legendFormat": "{{symbol}} bps"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Equity",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_account_equity",
          "legendFormat": "equity"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Day PnL",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity",
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_account_pnl_day",
          "legendFormat": "day pnl"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Top of book",
      "description": "Best bid, best ask and the mid between them.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*bid.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*ask.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_orderbook_bid_price{symbol=~\"$symbol\"}",
          "legendFormat": "{{symbol}} bid"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_orderbook_ask_price{symbol=~\"$symbol\"}",
          "legendFormat": "{{symbol}} ask"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_orderbook_mid_price{symbol=~\"$symbol\"}",
          "legendFormat": "{{symbol}} mid"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Spread (bps)",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_orderbook_spread_bps{symbol=~\"$symbol\"}",
          "legendFormat": "{{symbol}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Cash and buying power",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_account_cash",
          "legendFormat": "cash"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_account_buying_power",
          "legendFormat": "buying power"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Book depth (levels per side)",
      "description": "Alpaca publishes only top of book for equities — a flat 1 here is expected. Crypto pairs get real depth.",
      "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "cc-prometheus" },
          "expr": "cc_orderbook_levels{symbol=~\"$symbol\"}",
          "legendFormat": "{{symbol}} {{side}}"
        }
      ]
    }
  ]
}
